# Copy this file to a new file named ".env" and fill in the values after the "=" sign.
# Never upload the real ".env" file to GitHub (it is already listed in .gitignore).

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional. Leave empty: the app tries current Gemini models automatically (run npm run test:gemini to see which one works).
GEMINI_MODEL=

# Resend key for the contact form (https://resend.com/api-keys)
RESEND_API_KEY=
# The email address that receives enquiries
CONTACT_EMAIL=

# Optional. Leave empty to use Resend's test sender (onboarding@resend.dev).
CONTACT_FROM_EMAIL=
# Optional. Your live site address, e.g. https://your-name.vercel.app
ALLOWED_ORIGIN=
# Optional. Chat messages allowed per visitor per minute (default 12)
RATE_LIMIT_PER_MIN=

# --- Abuse protection (recommended for the live site) ---
# Shared rate limits that work across all servers. Create a free Redis database at https://upstash.com,
# open it, and copy the "REST URL" and "REST TOKEN" here. Leave empty to use simple in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Daily caps (defaults: 400 chat answers a day for the whole site, 60 per visitor; 40 enquiries a day)
CHAT_DAILY_LIMIT=
CHAT_PER_IP_DAILY=
CONTACT_DAILY_LIMIT=

# --- Advanced (leave empty unless you know you need them) ---
# ALLOWED_ORIGIN above is optional: requests from other websites are refused automatically.
# Set TRUST_PROXY=1 ONLY if you run behind your own reverse proxy that overwrites X-Forwarded-For. Leave empty on Vercel.
TRUST_PROXY=
# Random text used to anonymise visitor IPs in security log lines.
LOG_SALT=
# Seconds to wait for Resend per attempt, in milliseconds (default 10000).
RESEND_TIMEOUT_MS=
# Never set this on a live site: it makes error messages show technical details.
DEV_MODE=
